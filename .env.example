# VEIL — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -----------------------------------------------------------------------------
# IBM watsonx.ai credentials (REQUIRED for intelligence layer)
# Get these from: https://cloud.ibm.com/iam/apikeys and your watsonx project
# -----------------------------------------------------------------------------
WATSONX_API_KEY=your-ibm-cloud-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# -----------------------------------------------------------------------------
# Audit & threat memory persistence
# Paths are relative to the project root. Directories must exist.
# -----------------------------------------------------------------------------
AUDIT_FILE_PATH=data/audit.jsonl
THREAT_MEMORY_PATH=data/threats.jsonl

# -----------------------------------------------------------------------------
# Pipeline behaviour
# -----------------------------------------------------------------------------
# Minimum risk level that triggers Counter-Agent + Judge invocation.
# Valid values: NONE | LOW | MEDIUM | HIGH | CRITICAL
RISK_THRESHOLD_FOR_AGENTS=HIGH

# DecisionResult confidence below this value sets requires_human_review=True.
# Range: 0.0 – 1.0
CONFIDENCE_THRESHOLD_FOR_HUMAN_REVIEW=0.6

# -----------------------------------------------------------------------------
# Gateway API server
# -----------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
